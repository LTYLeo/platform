# Copy to .env (or export in your process manager) and adjust.
# Local development needs no changes — every default below is dev-safe.

# --- Cookies ---------------------------------------------------------------
# Send the session cookie only over HTTPS. MUST be true in production.
TAI_COOKIE_SECURE=false

# lax | strict | none
# 'none' is only needed when the site and the API sit on different registrable
# domains (e.g. github.io -> some-tunnel-domain). It requires
# TAI_COOKIE_SECURE=true and is blocked outright by Safari/iOS.
# Prefer one registrable domain (dev.example.com + api.example.com) and keep lax.
TAI_COOKIE_SAMESITE=lax

# How long a login lasts.
TAI_SESSION_DAYS=7

# --- Cross-origin ----------------------------------------------------------
# Comma-separated list of front-end origins allowed to send credentialed
# requests. Required whenever the pages are served from another origin,
# e.g. GitHub Pages.
# TAI_ALLOWED_ORIGINS=https://dev.yourdomain.com

# --- Deployment shape ------------------------------------------------------
# The API host runs the API only; the pages come from GitHub Pages.
# Set to false when deploying behind a tunnel.
TAI_SERVE_SITE=true

# Serve /api/docs and the OpenAPI schema. Handy locally, optional in production.
TAI_ENABLE_DOCS=true

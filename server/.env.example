# Copy to .env (or export in your process manager) and adjust.
# Local development needs no changes — every default below is dev-safe.

# --- Cookies ---------------------------------------------------------------
# Send the session cookie only over HTTPS. MUST be true in production.
TAI_COOKIE_SECURE=false

# lax | strict | none
# 'none' is only needed when the site and the API sit on different registrable
# domains (e.g. github.io -> some-tunnel-domain). It requires
# TAI_COOKIE_SECURE=true and is blocked outright by Safari/iOS.
# Prefer one registrable domain (dev.example.com + api.example.com) and keep lax.
TAI_COOKIE_SAMESITE=lax

# How long a login lasts.
TAI_SESSION_DAYS=7

# --- Cross-origin ----------------------------------------------------------
# Comma-separated list of front-end origins allowed to send credentialed
# requests. Required whenever the pages are served from another origin,
# e.g. GitHub Pages.
# TAI_ALLOWED_ORIGINS=https://dev.yourdomain.com

# --- Deployment shape ------------------------------------------------------
# The API host runs the API only; the pages come from GitHub Pages.
# Set to false when deploying behind a tunnel.
TAI_SERVE_SITE=true

# Serve /api/docs and the OpenAPI schema. Handy locally, optional in production.
TAI_ENABLE_DOCS=true

# --- Model backend ---------------------------------------------------------
# The Assistant API (/api/v1/*) needs something to generate text.
#
#   stub              (default) deterministic, offline echo. Clearly marked
#                     "[stub backend]" in every reply and never billed as if it
#                     were a real model. Use it to develop the client and the
#                     plumbing before a model exists.
#   openai_compatible forwards to a real OpenAI-compatible server. This is how
#                     you attach vLLM, llama.cpp server, Ollama or LM Studio.
TAI_MODEL_BACKEND=stub

# Required when TAI_MODEL_BACKEND=openai_compatible. Include the version prefix,
# e.g. http://127.0.0.1:8001/v1 or http://127.0.0.1:11434/v1 (Ollama).
# TAI_MODEL_BASE_URL=http://127.0.0.1:8001/v1

# Optional bearer token for the upstream model server.
# TAI_MODEL_API_KEY=

# Upstream request timeout in seconds (default 60).
# TAI_MODEL_TIMEOUT_S=60

# Artificial per-chunk delay for the stub stream, in milliseconds. Useful for
# exercising client-side streaming and disconnect handling.
# TAI_STUB_STREAM_DELAY_MS=0


# --- Billing ---------------------------------------------------------------
# Shared secret for the internal API that Sigma calls to ask "what is this
# account entitled to?". If it is unset the internal API stays CLOSED rather
# than open: an unauthenticated endpoint that reads entitlements is not a safe
# default. Generate one with:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# TAI_INTERNAL_TOKEN=

# Afdian (爱发电). No business licence needed, settles to you directly. Get both
# values from https://afdian.com/dashboard/dev
# TAI_AFDIAN_TOKEN=
# TAI_AFDIAN_USER_ID=
# TAI_AFDIAN_PAGE=https://afdian.com/a/tai_research

# WeChat Pay Native (scan-to-pay on our own page). Needs a merchant id and a
# signing certificate, which come either from a business licence or from a
# payment service provider that onboards individuals as micro-merchants (money
# still settles to a personal bank card). Not implemented until these exist:
# ordering a payment without valid signing keys would produce unscannable codes.
# TAI_WECHAT_MCHID=
# TAI_WECHAT_API_V3_KEY=
